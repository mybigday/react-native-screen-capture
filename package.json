{
  "name": "@fugood/react-native-screen-capture",
  "version": "3.0.0",
  "description": "Programmatic screenshots for React Native, including video and camera components",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "android/consumer-rules.pro",
    "ios/ScreenCapture",
    "*.podspec",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepare": "bob build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybigday/react-native-screen-capture.git"
  },
  "keywords": [
    "react-native",
    "screenshot",
    "screen-capture",
    "surfaceview",
    "camera",
    "video"
  ],
  "author": "BRICKS INC. <dev@bricks.tools>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mybigday/react-native-screen-capture/issues"
  },
  "homepage": "https://github.com/mybigday/react-native-screen-capture#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.6.0"
  },
  "codegenConfig": {
    "name": "RNScreenCaptureSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.fugood.screencapture"
    },
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
